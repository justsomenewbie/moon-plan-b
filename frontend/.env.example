# Rebuild/restart after changing. Never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=mock
# Live example: NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production chatbot: add OPENAI_API_KEY in the hosting provider's server-side secret settings.
# ASTRONAUT_CHAT_ORIGIN must be the browser's exact origin with no trailing slash.
# ASTRONAUT_CHAT_ORIGIN=https://moon.example.org
