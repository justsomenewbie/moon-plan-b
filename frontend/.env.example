# Rebuild after changing the origin. Set secret values only on the server.
NEXT_PUBLIC_API_BASE_URL=mock
# Team LAN example: NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Public data service: NEXT_PUBLIC_API_BASE_URL=https://api.lunavigator.com
# Configure LUNARNAV_API_KEY separately in the server runtime.

# Optional hosted chatbot: set OPENAI_API_KEY in the server-side secret settings.
# ASTRONAUT_CHAT_ORIGIN must be the browser's exact origin without a trailing slash.
# ASTRONAUT_CHAT_ORIGIN=https://moon-plan-b.vercel.app
