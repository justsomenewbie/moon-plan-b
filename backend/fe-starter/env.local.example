# Next.js app (.env.local). Copy the variables you need.

# Server side (RSC, route handlers, the /api/lunar proxy): absolute origin of the backend.
#   backend dev server: http://127.0.0.1:3000   Prism mock: http://127.0.0.1:4010   production: https://api.lunavigator.com
API_INTERNAL_URL=http://127.0.0.1:3000

# Server side ONLY: API key of this FE (ask the backend operator; one of its API_KEYS). Sent as X-API-Key by
# src/lib/api/client.ts on the server and by app/api/lunar/[...path]/route.ts. NEVER rename it to NEXT_PUBLIC_*.
# Empty = backend without keys (local dev server with API_KEYS unset, Prism mock).
LUNARNAV_API_KEY=

# Browser side: leave EMPTY -> the browser calls /api/lunar/api/v1/... (the server-side proxy adds the key).
# Set it only for a backend WITHOUT API keys called cross-origin (the backend must list the FE origin in CORS_ORIGINS).
NEXT_PUBLIC_API_ORIGIN=
