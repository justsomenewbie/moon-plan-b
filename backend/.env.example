# lunarnav backend - local development settings.
#
#   Linux/macOS:         cp .env.example .env
#   Windows PowerShell:  Copy-Item .env.example .env
#
# `npm run dev`, `npm start` and `npm run import` load .env from the backend/ directory
# (node --env-file-if-exists=.env). Every value is validated by src/config.ts (zod); an empty
# value counts as "unset" and gets the default. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
# The Next.js frontend dev server uses port 3000, so the API listens on 8000 here
# (config default without .env: 3000). Pick any free port.
PORT=8000
LOG_LEVEL=info

# MongoDB 8 without auth on this machine, e.g. `docker run -d --name lunarnav-mongo -p 27017:27017 mongo:8`.
# The tests never use this database (they start mongodb-memory-server).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lunarnav_local

# Browser origins allowed by CORS (comma separated, "*" = any). Next.js dev server:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Python bridge (lunarnav). Leave these three unset: the defaults are absolute paths computed from
# the backend/ directory and work on Linux, macOS and Windows:
#   PYTHON_BIN    = <repo>/.venv/bin/python   (Windows: <repo>\.venv\Scripts\python.exe)
#   LUNARNAV_ROOT = <repo>                    (the lunarnav checkout, working dir of Python children)
#   DATA_DIR      = <repo>/backend/data       (imported runs: DATA_DIR/runs/<run_id>/, job files)
# If you override them, use ABSOLUTE paths (Python children run with cwd = LUNARNAV_ROOT).
# Production example (VPS): PYTHON_BIN=/opt/lunarnav/py/.venv/bin/python
# PYTHON_BIN=
# LUNARNAV_ROOT=
# DATA_DIR=

# Jobs (custom coordinates, Python tools) and the synchronous alt-dates bridge
JOB_TIMEOUT_S=1200
JOB_CONCURRENCY=1
JOB_QUEUE_MAX=20
# queued+running jobs one client (IP, IPv6 /64) may wait on (0 = unlimited); concurrent SSE streams per client
JOB_MAX_ACTIVE_PER_CLIENT=2
SSE_MAX_PER_CLIENT=5
ALTDATES_TIMEOUT_S=30
CUSTOM_RUN_TTL_DAYS=30
# API-created precompute runs (possibly large) live shorter
PRECOMPUTE_RUN_TTL_DAYS=7
# Storage budget of job runs (custom_site / precompute), checked when a new job is queued; 0 = no limit
JOB_RUNS_MAX_PER_CLIENT=20
JOB_RUNS_MAX_TOTAL=200
JOB_RUNS_MAX_MB=10240
DATA_DIR_MIN_FREE_MB=2048
# PGDA tile cache: new MB per UTC day (then 429 QUOTA_EXCEEDED for dem pgda work) and size cap (oldest blocks trimmed)
PGDA_DOWNLOAD_MAX_MB_PER_DAY=1024
PGDA_CACHE_MAX_MB=4096

# Rate limits (requests per minute per IP): global, and POST /alt-dates + POST /jobs
RATE_LIMIT_MAX=300
RATE_LIMIT_POST_MAX=5
# POST /tools/* (sync Python), per minute per IP and tool
RATE_LIMIT_TOOLS_MAX=30
# GET /capabilities: HEAD probe of JPL Horizons / PGDA (true|false; default on, off under NODE_ENV=test) and cache TTL
# CAPABILITIES_NETWORK_PROBE=true
# CAPABILITIES_TTL_S=600

# Response compression in Node (turn off when the reverse proxy compresses in production)
COMPRESS=true

# Authentication (src/lib/auth.ts). With keys set, every /api/v1 route except GET /api/v1/health needs
#   X-API-Key: <key>   (or Authorization: Bearer <key>)
# API_KEYS: comma separated, optionally name:key so logs / rate limits name the client, e.g.
#   API_KEYS=dev:<key>
# Generate a key (>= 32 chars; required when NODE_ENV=production):
#   Linux/macOS:  openssl rand -hex 32
#   Any OS:       node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Empty here (development) = authentication OFF, one warning at startup.
API_KEYS=
# HTTP Basic auth of /docs and /api/v1/openapi.json (set both or neither; required in production,
# password >= 12 chars). Unset in development = docs open.
DOCS_USER=
DOCS_PASSWORD=
