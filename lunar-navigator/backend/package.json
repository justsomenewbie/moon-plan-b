{
  "name": "lunarnav-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lunar Landing Site Navigator - web backend (Fastify 5 + zod 4 + MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi:export": "node scripts/export-openapi.ts",
    "mock": "npx -y @stoplight/prism-cli@5.15.11 mock -h 127.0.0.1 -p 4010 contract/openapi.json",
    "import": "node --env-file-if-exists=.env scripts/import-run.ts",
    "openapi:check": "node scripts/export-openapi.ts --check",
    "fixtures": "..\\.venv\\Scripts\\python.exe -I scripts/make-fixtures.py ../output/sample_2026Q1_spice_pgda",
    "lint:openapi": "npx -y @redocly/cli@2.78.0 lint contract/openapi.json",
    "test:slow": "node scripts/test-slow.ts",
    "examples:capture": "node --env-file-if-exists=.env contract/examples/capture.ts",
    "examples:check": "node --env-file-if-exists=.env contract/examples/capture.ts --check"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.4",
    "@fastify/swagger-ui": "6.1.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "execa": "10.2.1",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "mongodb": "7.9.0",
    "openapi-types": "12.1.3",
    "p-queue": "10.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "mongodb-memory-server": "11.3.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.23"
    }
  }
}
