# Copy to .env (never commit .env). Every value is validated by src/config.ts (zod).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# MongoDB (dev: local Windows service, no auth). Tests never use this - they use mongodb-memory-server.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lunarnav_dev

# Comma separated allow-list ("*" = any origin). Next.js dev server:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Python bridge (lunarnav). VPS: /opt/lunarnav/py/.venv/bin/python and /opt/lunarnav/lunar-navigator
PYTHON_BIN=D:\UAV\lunar-navigator\.venv\Scripts\python.exe
LUNARNAV_ROOT=D:\UAV\lunar-navigator

# Imported precompute directories live in DATA_DIR/runs/<run_id>/ (VPS: /opt/lunarnav/data)
DATA_DIR=D:\UAV\lunar-navigator\backend\data

# Jobs (custom coordinates) and the synchronous alt-dates bridge
JOB_TIMEOUT_S=1200
JOB_CONCURRENCY=1
JOB_QUEUE_MAX=20
# queued+running jobs one client (IP, IPv6 /64) may wait on (0 = unlimited); concurrent SSE streams per client
JOB_MAX_ACTIVE_PER_CLIENT=2
SSE_MAX_PER_CLIENT=5
ALTDATES_TIMEOUT_S=30
CUSTOM_RUN_TTL_DAYS=30
# API-created precompute runs (possibly large) live shorter
PRECOMPUTE_RUN_TTL_DAYS=7
# Storage budget of job runs (custom_site / precompute), checked when a new job is queued; 0 = no limit
JOB_RUNS_MAX_PER_CLIENT=20
JOB_RUNS_MAX_TOTAL=200
JOB_RUNS_MAX_MB=10240
DATA_DIR_MIN_FREE_MB=2048
# PGDA tile cache: new MB per UTC day (then 429 QUOTA_EXCEEDED for dem pgda work) and size cap (oldest blocks trimmed)
PGDA_DOWNLOAD_MAX_MB_PER_DAY=1024
PGDA_CACHE_MAX_MB=4096

# Rate limits (requests per minute per IP): global, and POST /alt-dates + POST /jobs
RATE_LIMIT_MAX=300
RATE_LIMIT_POST_MAX=5
# POST /tools/* (sync Python), per minute per IP and tool
RATE_LIMIT_TOOLS_MAX=30
# GET /capabilities: HEAD probe of JPL Horizons / PGDA (true|false; default on, off under NODE_ENV=test) and cache TTL
# CAPABILITIES_NETWORK_PROBE=true
# CAPABILITIES_TTL_S=600

# Response compression in Node (turn off when Caddy does "encode" in production)
COMPRESS=true

# Authentication (src/lib/auth.ts). Every /api/v1 route except GET /api/v1/health needs
#   X-API-Key: <key>   (or Authorization: Bearer <key>)
# API_KEYS: comma separated, optionally name:key so logs / rate limits name the client, e.g.
#   API_KEYS=fe:<key>,tester:<key>
# Generate each key with:  openssl rand -hex 32     (>= 32 chars; required when NODE_ENV=production)
# Empty here (development) = authentication OFF, one warning at startup.
API_KEYS=
# HTTP Basic auth of /docs and /api/v1/openapi.json (both or neither; required in production, password >= 12 chars).
# Unset in development = docs open.
DOCS_USER=
DOCS_PASSWORD=
