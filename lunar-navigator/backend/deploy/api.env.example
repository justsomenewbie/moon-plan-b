# /etc/lunarnav/api.env - production environment of the API (root:lunar, chmod 640).
# provision-ubuntu.sh writes it once from this template (never overwrites an existing file).
# Read by Node's --env-file (pm2 ecosystem + deploy/import-run.sh): KEY=value, no quotes, no spaces, no '#'
# inside values. Every key is validated by backend/src/config.ts at startup.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# MongoDB 8.0 on this VPS, user lunarnav_app (readWrite on lunarnav only).
MONGODB_URI=__MONGODB_URI__
MONGODB_DB=lunarnav

# Browser origins allowed to call the API cross-origin. Same-origin setups (Caddy app domain) need none,
# but the value must not be empty: keep the FE origin here.
CORS_ORIGINS=__CORS_ORIGINS__

# Python bridge (lunarnav installed editable from the repo checkout into the venv).
PYTHON_BIN=/opt/lunarnav/py/.venv/bin/python
LUNARNAV_ROOT=/opt/lunarnav/lunar-navigator
# Inherited by the Python child processes: SPICE kernels / DEM / HTTP cache, and lunarnav's default output dir.
LUNARNAV_DATA=/opt/lunarnav/data/py
LUNARNAV_OUTPUT=/opt/lunarnav/data/py-output

# Imported precompute runs live in DATA_DIR/runs/<run_id>/ (kept: raw downloads + alt-dates bridge read them).
DATA_DIR=/opt/lunarnav/data

JOB_TIMEOUT_S=1200
JOB_CONCURRENCY=1
JOB_QUEUE_MAX=20
# queued+running jobs one client (IP, IPv6 /64) may wait on (0 = unlimited); concurrent SSE streams per client
JOB_MAX_ACTIVE_PER_CLIENT=2
SSE_MAX_PER_CLIENT=5
ALTDATES_TIMEOUT_S=30
CUSTOM_RUN_TTL_DAYS=30
# API-created precompute runs (possibly large) live shorter
PRECOMPUTE_RUN_TTL_DAYS=7
# Storage budget of job runs (custom_site / precompute), checked when a new job is queued; 0 = no limit
JOB_RUNS_MAX_PER_CLIENT=20
JOB_RUNS_MAX_TOTAL=200
JOB_RUNS_MAX_MB=10240
DATA_DIR_MIN_FREE_MB=2048
# PGDA tile cache: new MB per UTC day (then 429 QUOTA_EXCEEDED for dem pgda work) and size cap (oldest blocks trimmed)
PGDA_DOWNLOAD_MAX_MB_PER_DAY=1024
PGDA_CACHE_MAX_MB=4096

RATE_LIMIT_MAX=300
RATE_LIMIT_POST_MAX=5

# Caddy compresses (encode) -> no compression in Node.
COMPRESS=false

# ---- Authentication (REQUIRED: the API refuses to start in production without these) -------------------
# Every /api/v1 route except GET /api/v1/health needs  X-API-Key: <key>  (or Authorization: Bearer <key>).
# Comma separated name:key pairs; the name shows in the logs (field "client") and is the rate-limit key
# (all requests of one key share RATE_LIMIT_MAX / RATE_LIMIT_POST_MAX per minute).
# One key per client, each generated with:  openssl rand -hex 32   (>= 32 chars)
#   API_KEYS=fe:<64 hex>,tester:<64 hex>
# Rotate: add the new key, deploy the FE with it, then remove the old one (pm2 restart lunarnav-api).
API_KEYS=
# HTTP Basic auth of /docs (Swagger UI) and /api/v1/openapi.json. Password >= 12 chars, no spaces / '#'
# (e.g. openssl rand -hex 16).
DOCS_USER=
DOCS_PASSWORD=
